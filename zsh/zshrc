###############################################################################
# Git aliases
###############################################################################
dirdump() {
    echo "📁 $(pwd)"
    ls --color=auto -Fh --group-directories-first
    echo
}

gst() {
    if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" ]; then
        git st
    else
        dirdump
    fi
}

ga() {
    if [ $# -eq 0 ]; then
        dirdump
    elif [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" ]; then
        git add "$@"
        for arg in "$@"; do
            echo "➕ $arg"
        done
        echo
        git st
    else
        dirdump
    fi
}


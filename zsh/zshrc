# Extract file
extract() {
    if [ -f $1 ] ; then
        case $1 in
            *.tar.bz2)  tar xjf $1      ;;
            *.tar.gz)   tar xzf $1      ;;
            *.bz2)      bunzip2 $1      ;;
            *.rar)      rar x $1        ;;
            *.gz)       gunzip $1       ;;
            *.tar)      tar xf $1       ;;
            *.tbz2)     tar xjf $1      ;;
            *.tgz)      tar xzf $1      ;;
            *.zip)      unzip $1        ;;
            *.Z)        uncompress $1   ;;
            *)          echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# 1. Find all files and directories under the current directory, sorted alphabetically
# 2. Replace the "." with the basename of the current directory
# 3. Append a "/" to the end of each directory name
dump() {
  find . -type f -o -type d |
  sort |
  awk '{
    # If the line ends in "/", print the line with a "/" appended
    if (system("[ -d \"" $1 "\" ]") == 0) {
      print $1 "/"
    }
    # If the line does not end in "/", print the line with a "?" appended
    else {
      print $1 ""
    }
  }' |
  sed "s|^\.|$(basename "$(pwd)")|"
}

srcdump() {
  dump |
  grep -vE "(.git|.next|build|cache|coverage|dist|log|logs|node_modules|out|site|tmp|venv)"
}



###############################################################################
# AI Agent Settings
###############################################################################
#
# Special settings for AI agents (Claude, Codex, Cursor, Gemini, etc.)
# These settings optimize the shell for non-interactive automation
#
# Detected automatically via environment variables:
#   CLAUDECODE=1           - Set by Claude Code
#   CODEX_MANAGED_BY_NPM=1 - Set by OpenAI Codex
#   CURSOR_AGENT=1         - Set by Cursor
#   GEMINI_CLI=1           - Set by Google Gemini CLI
#
# Note: Claude Code also uses CLAUDE_ENV_FILE for per-command setup (see ~/.claude-env.sh)
#

if is_ai_agent; then

    # Disable history expansion (!) to avoid issues with special characters
    setopt NO_BANG_HIST

    # Use non-interactive editors and pagers
    export EDITOR=nano
    export VISUAL=nano
    export PAGER=cat
    export GIT_PAGER=cat
    export LESS="-R --quit-if-one-screen --no-init"

    # Override file operation aliases to be non-interactive
    alias cp="cp -f"
    alias mv="mv -f"
    alias rm="rm -f"

    # Package managers - non-interactive mode
    alias apt="apt -y"
    alias apt-get="apt-get -y"
    alias npm="npm --yes"
    alias yarn="yarn --non-interactive"
    alias pip="pip --quiet"
    alias pip3="pip3 --quiet"

    # Git - prevent interactive prompts
    alias git="git -c core.editor=true -c merge.tool=false"

    # Make/build tools - non-interactive
    alias make="make --no-print-directory"

    # File operations with progress
    alias rsync="rsync --progress"

    # Separate history file for each agent
    if [[ -n "$CLAUDECODE" ]]; then
        export HISTFILE=~/.zsh_history_claude
    elif [[ -n "$CODEX_MANAGED_BY_NPM" ]]; then
        export HISTFILE=~/.zsh_history_codex
    elif [[ -n "$CURSOR_AGENT" ]]; then
        export HISTFILE=~/.zsh_history_cursor
    elif [[ -n "$GEMINI_CLI" ]]; then
        export HISTFILE=~/.zsh_history_gemini
    else
        export HISTFILE=~/.zsh_history_agent
    fi

    # Environment variables for non-interactive operation
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONUNBUFFERED=1

fi




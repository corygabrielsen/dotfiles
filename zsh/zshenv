#!/usr/bin/env zsh
#
# The ~/.zshenv file is a configuration file for the Z shell (zsh) that is
# sourced (executed) for all invocations of the shell — login, interactive,
# non-interactive, and scripts. Put environment variables and PATH setup here
# so that subprocesses (git hooks, CI, pre-commit, editors) can find tools.
#
# Do NOT put anything that produces output, modifies terminal state, or is
# only relevant to interactive use. Those belong in ~/.zshrc.
#
#   ln -s path/to/dotfiles/zsh/zshenv ~/.zshenv
#

# Source local environment variables if the file exists
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local

# Claude Code environment file
# This tells Claude Code to source ~/.claude-env.sh before each command
export CLAUDE_ENV_FILE=~/.claude-env.sh



###############################################################################
# Environment Variables
###############################################################################

export LANG=en_US.UTF-8
export GPG_TTY=$(tty)

# Build tools - use all available cores for parallel compilation
if command -v nproc >/dev/null 2>&1; then
    export MAKEFLAGS="-j$(nproc)"
elif [[ "${OSTYPE}" == "darwin"* ]]; then
    export MAKEFLAGS="-j$(sysctl -n hw.ncpu)"
fi



###############################################################################
# X Server
###############################################################################

if [[ "${OSTYPE}" == "darwin"* ]]; then
    export DISPLAY=$(ipconfig getifaddr en0):0
fi



###############################################################################
# Homebrew (Linuxbrew)
###############################################################################

if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi



###############################################################################
# nvm
###############################################################################

export NVM_DIR="$HOME/.nvm"

# Add default node to PATH without sourcing slow nvm.sh (~300ms).
# Full nvm is loaded in .zshrc for interactive `nvm use`/`nvm install`.
# Resolves alias chain (default -> node -> latest) to find the bin directory.
if [[ -d "$NVM_DIR/versions/node" ]]; then
    _nvm_ver=$(<"$NVM_DIR/alias/default" 2>/dev/null)
    # Resolve alias chain: "node" or "lts/*" -> pick latest installed
    if [[ "$_nvm_ver" == "node" || -z "$_nvm_ver" ]]; then
        _nvm_bins=("$NVM_DIR"/versions/node/v*/bin(NnOn))
    else
        _nvm_bins=("$NVM_DIR"/versions/node/v${_nvm_ver}*/bin(NnOn))
    fi
    (( ${#_nvm_bins} )) && export PATH="${_nvm_bins[1]}:$PATH"
    unset _nvm_ver _nvm_bins
fi



###############################################################################
# bun
###############################################################################

export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"



###############################################################################
# go
###############################################################################

if [[ -d /usr/local/go ]]; then
    export PATH="${PATH}:/usr/local/go/bin"
    export GOPATH="${HOME}/go"
fi



###############################################################################
# rust
###############################################################################

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

for _foundry_path in "$HOME/.foundry/bin" "/usr/local/foundry/bin"; do
    if [[ -d "$_foundry_path" ]]; then
        export PATH="$PATH:$_foundry_path"
        break
    fi
done
unset _foundry_path



###############################################################################
# pyenv
###############################################################################

if command -v pyenv 1>/dev/null 2>&1; then
    eval "$(pyenv init -)"
fi



###############################################################################
# User-specific binaries
###############################################################################

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# opencode
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

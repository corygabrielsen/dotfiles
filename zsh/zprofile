# shellcheck shell=sh
# =============================================================================
# .zprofile - Re-source ~/.profile after macOS path_helper demotion
# =============================================================================
#
# zsh sources files in this order on login shells:
#   /etc/zshenv → ~/.zshenv → /etc/zprofile → ~/.zprofile → ...
#
# ~/.zshenv has already sourced ~/.profile, so on Linux this file would
# only repeat the work for no benefit (the dedup at the end of ~/.profile
# keeps PATH stable but the profile.d/* drop-ins still re-fork external
# tools, source ~/.local/bin/env again, etc.).
#
# On macOS, /etc/zprofile runs `path_helper` between ~/.zshenv and this
# file, which rebuilds PATH from /etc/paths and /etc/paths.d/* — putting
# system paths at the front and demoting every PATH prepend our profile
# made (Homebrew, nvm, pyenv shims). Re-sourcing ~/.profile here re-
# prepends the toolchain dirs over path_helper's output, and the dedup
# at the end of ~/.profile keeps the fresh (front) copies and drops the
# demoted duplicates.
#
# Symlinked to ~/.zprofile by `make`.
# =============================================================================

if [ "$(command uname)" = "Darwin" ]; then
    # Re-source ~/.profile to re-prepend toolchain dirs over path_helper's
    # demoted PATH. profile.d/99-local.sh keeps its `_PROFILE_LOCAL_LOADED`
    # guard set, so the user hook in ~/.profile.local does NOT run again
    # — that file is for one-shot setup and re-running would duplicate
    # side effects (agent launches, log writes, etc.).
    #
    # Caveat: any PATH prepends in ~/.profile.local stay demoted by
    # path_helper here, since the user hook isn't re-run. Put per-shell
    # PATH adjustments in ~/.zshrc.local (runs post-path_helper, in
    # interactive zsh) or in a new profile.d/ drop-in instead.
    # shellcheck disable=SC1091  # symlinked at install time
    . "$HOME/.profile"
fi
